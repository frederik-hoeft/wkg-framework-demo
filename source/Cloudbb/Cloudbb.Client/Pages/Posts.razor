@page "/posts"
@using Cloudbb.Client.Models
@using Cloudbb.Client.Services.Posts
@using Cloudbb.Client.Services.TimeZone
@inject IPostService PostService
@inject ITimeZoneService TimeZoneService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Posts - Cloudbb Forum</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudPaper Class="pa-4 mb-4">
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.h4">Forum Posts</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" Class="d-flex justify-end align-center">
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.Add"
                           Href="/posts/create">
                    Create Post
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudSelect @bind-Value="sortMode" @bind-Value:after="OnSortChanged" Label="Sort By" Variant="Variant.Outlined">
                    <MudSelectItem Value="@PostListSortMode.Activity">Activity</MudSelectItem>
                    <MudSelectItem Value="@PostListSortMode.Score">Score</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect @bind-Value="sortOrder" @bind-Value:after="OnSortChanged" Label="Order" Variant="Variant.Outlined">
                    <MudSelectItem Value="@SortOrder.Descending">Descending</MudSelectItem>
                    <MudSelectItem Value="@SortOrder.Ascending">Ascending</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField @bind-Value="pageSize" @bind-Value:after="OnPageSizeChanged" Label="Posts Per Page" Variant="Variant.Outlined" Min="5" Max="100" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (isLoading)
    {
        <MudPaper Class="pa-8 text-center">
            <MudProgressCircular Size="Size.Large" Indeterminate="true" />
        </MudPaper>
    }
    else if (posts is null || posts.Count == 0)
    {
        <MudPaper Class="pa-8 text-center">
            <MudText Typo="Typo.h6" Color="Color.Default">No posts found</MudText>
            <MudText Class="mt-2">Be the first to create a post!</MudText>
        </MudPaper>
    }
    else
    {
        @foreach (PostListResponseEntry post in posts)
        {
            <MudPaper Class="pa-4 mb-3 hover-effect" Style="cursor: pointer;" @onclick="@(() => NavigateToPost(post.PostId))">
                <MudGrid>
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Color="Color.Primary">@post.Title</MudText>
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.body2" Color="Color.Default">@post.ContentPreview</MudText>
                    </MudItem>
                    <MudItem xs="12">
                        <MudStack Row="true" Spacing="4" Class="mt-2">
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.ThumbUp">
                                Score: @post.VoteScore
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Icon="@Icons.Material.Filled.Comment">
                                @post.CommentCount Comments
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Icon="@Icons.Material.Filled.Edit">
                                @post.Revisions Revisions
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Icon="@Icons.Material.Filled.Schedule">
                                @post.LastModified.ToString("g")
                            </MudChip>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }

        @if (paginationInfo is not null)
        {
            <MudPaper Class="pa-4 mt-4">
                <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="2">
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               Disabled="@(currentPage <= 1)"
                               OnClick="@(() => GoToPage(1))">
                        First
                    </MudButton>
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               Disabled="@(currentPage <= 1)"
                               OnClick="@(() => GoToPage(currentPage - 1))">
                        Previous
                    </MudButton>
                    <MudText>Page @currentPage of @paginationInfo.TotalPages</MudText>
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               Disabled="@(currentPage >= paginationInfo.TotalPages)"
                               OnClick="@(() => GoToPage(currentPage + 1))">
                        Next
                    </MudButton>
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               Disabled="@(currentPage >= paginationInfo.TotalPages)"
                               OnClick="@(() => GoToPage(paginationInfo.TotalPages))">
                        Last
                    </MudButton>
                </MudStack>
            </MudPaper>
        }
    }
</MudContainer>

@code {
    private List<PostListResponseEntry>? posts;
    private PaginationInfo? paginationInfo;
    private bool isLoading = true;
    private int currentPage = 1;
    private int pageSize = 20;
    private PostListSortMode sortMode = PostListSortMode.Activity;
    private SortOrder sortOrder = SortOrder.Descending;

    protected override async Task OnInitializedAsync()
    {
        await LoadPostsAsync();
    }

    private async Task LoadPostsAsync()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            Models.TimeZone timeZone = await TimeZoneService.GetTimeZoneAsync();
            PostListRequest request = new()
            {
                TimeZone = timeZone,
                PageNumber = currentPage,
                PageSize = pageSize,
                SortMode = sortMode,
                SortOrder = sortOrder
            };

            PostListResponse? response = await PostService.GetPostsAsync(request);
            if (response is not null)
            {
                posts = response.Posts;
                paginationInfo = response.PaginationInfo;
            }
            else
            {
                Snackbar.Add("Failed to load posts", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading posts: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void NavigateToPost(Guid postId)
    {
        Navigation.NavigateTo($"/posts/{postId}");
    }

    private async Task GoToPage(int page)
    {
        currentPage = page;
        await LoadPostsAsync();
    }

    private async Task OnSortChanged()
    {
        currentPage = 1;
        await LoadPostsAsync();
    }

    private async Task OnPageSizeChanged()
    {
        currentPage = 1;
        await LoadPostsAsync();
    }
}
