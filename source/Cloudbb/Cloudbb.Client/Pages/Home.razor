@page "/"

<PageTitle>Cloudbb Forum</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudContainer MaxWidth="MaxWidth.Large">
            <MudText Style="margin-top: 2rem" Typo="Typo.h3" Class="mb-4">Welcome to Cloudbb Forum</MudText>
            <MudText Typo="Typo.h5" Class="mb-6">Hello, @context.User.Identity?.Name!</MudText>
            
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudPaper Class="pa-4" Elevation="2">
                        <MudText Typo="Typo.h6" Class="mb-2">Recent Posts</MudText>
                        <MudText>View and interact with the latest forum discussions.</MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" Href="/posts">
                            View Posts
                        </MudButton>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudPaper Class="pa-4" Elevation="2">
                        <MudText Typo="Typo.h6" Class="mb-2">Create a Post</MudText>
                        <MudText>Share your thoughts and start a new discussion.</MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" Href="/posts/create">
                            Create Post
                        </MudButton>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </Authorized>
    <NotAuthorized>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="text-center">
            <MudText Typo="Typo.h4" Class="mb-4">Welcome to Cloudbb Forum</MudText>
            <MudText Typo="Typo.body1" Class="mb-6">
                Join our community to share your thoughts, engage in discussions, and connect with others.
            </MudText>
            
            <MudGrid Justify="Justify.Center" Spacing="4">
                <MudItem>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Href="/login">
                        Login
                    </MudButton>
                </MudItem>
                <MudItem>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" Href="/register">
                        Register
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </NotAuthorized>
</AuthorizeView>
