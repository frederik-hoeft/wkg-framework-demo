@page "/register"
@using Cloudbb.Client.Services.Auth
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="pt-8">
    <MudPaper Class="pa-8">
        <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary" Class="mb-6">
            Register
        </MudText>

        <EditForm Model="@registerRequest" OnValidSubmit="@HandleRegister">
            <DataAnnotationsValidator />
            
            <MudTextField @bind-Value="registerRequest.Username"
                          Label="Username"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Margin="Margin.Normal"
                          For="@(() => registerRequest.Username)" />

            <MudTextField @bind-Value="registerRequest.Email"
                          Label="Email"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Margin="Margin.Normal"
                          InputType="InputType.Email"
                          For="@(() => registerRequest.Email)" />

            <MudTextField @bind-Value="registerRequest.Password"
                          Label="Password"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Margin="Margin.Normal"
                          InputType="InputType.Password"
                          For="@(() => registerRequest.Password)"
                          HelperText="Password must be at least 16 characters long" />

            <MudTextField @bind-Value="registerRequest.ConfirmPassword"
                          Label="Confirm Password"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Margin="Margin.Normal"
                          InputType="InputType.Password"
                          For="@(() => registerRequest.ConfirmPassword)" />

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Class="mt-4"
                       Disabled="@isLoading">
                @if (isLoading)
                {
                    <MudProgressCircular Class="mr-3" Size="Size.Small" Indeterminate="true" />
                }
                Register
            </MudButton>
        </EditForm>

        <MudDivider Class="my-6" />

        <MudText Align="Align.Center">
            Already have an account? 
            <MudLink Href="/login" Color="Color.Primary">Login here</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    private RegisterRequest registerRequest = new();
    private bool isLoading = false;

    private async Task HandleRegister()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            bool success = await AuthService.RegisterAsync(registerRequest);
            
            if (success)
            {
                Snackbar.Add("Registration successful! Please log in.", Severity.Success);
                Navigation.NavigateTo("/login");
            }
            else
            {
                Snackbar.Add("Registration failed. Please check your information.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"An error occurred: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}